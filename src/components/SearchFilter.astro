---
interface Props {
  placeholder?: string;
  targetSelector?: string;
  tags?: string[];
}

const {
  placeholder = 'Search by keyword, tag, or topic...',
  targetSelector = '.curated-link-card',
  tags = [],
} = Astro.props;
---

<section class="grep-filter-container" data-target={targetSelector}>
  <input
    type="search"
    class="grep-input-field"
    placeholder={placeholder}
    aria-label="Search filter"
  />

  {tags.length > 0 && (
    <div class="quick-tags-row">
      <span class="quick-tags-label">TAGS:</span>
      <button type="button" class="quick-tag-btn active" data-tag="all">[ALL]</button>
      {tags.map((t) => (
        <button type="button" class="quick-tag-btn" data-tag={t}>
          [{t}]
        </button>
      ))}
    </div>
  )}
</section>

<style>
  .grep-filter-container {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 10px 14px;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .grep-input-field {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 6px 10px;
    outline: none;
  }

  .grep-input-field:focus {
    border-color: var(--primary);
  }

  .quick-tags-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
  }

  .quick-tags-label {
    font-weight: bold;
    color: var(--text-muted);
    font-size: 11px;
    margin-right: 4px;
  }

  .quick-tag-btn {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 1px 6px;
    cursor: pointer;
  }

  .quick-tag-btn:hover {
    border-color: var(--text);
  }

  .quick-tag-btn.active {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
    font-weight: bold;
  }
</style>

<script is:inline>
  // Live grep filter with multi-tag selection
  document.querySelectorAll('.grep-filter-container').forEach((container) => {
    const targetSelector = container.getAttribute('data-target') || '.curated-link-card';
    const input = container.querySelector('.grep-input-field');
    const allBtn = container.querySelector('.quick-tag-btn[data-tag="all"]');
    const tagButtons = container.querySelectorAll('.quick-tag-btn:not([data-tag="all"])');
    const selectedTags = new Set();

    function filterItems() {
      const query = input ? input.value.toLowerCase().trim() : '';
      const items = document.querySelectorAll(targetSelector);

      items.forEach((item) => {
        const text = item.innerText.toLowerCase();
        const itemTags = (item.getAttribute('data-tags') || '')
          .split(',')
          .map((t) => t.trim().toLowerCase())
          .filter(Boolean);

        const matchesQuery = !query || text.includes(query);
        const matchesTag = selectedTags.size === 0 || Array.from(selectedTags).some((t) => itemTags.includes(t));

        if (matchesQuery && matchesTag) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    }

    if (input) {
      input.addEventListener('input', filterItems);
    }

    if (allBtn) {
      allBtn.addEventListener('click', () => {
        selectedTags.clear();
        allBtn.classList.add('active');
        tagButtons.forEach((b) => b.classList.remove('active'));
        filterItems();
      });
    }

    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = (btn.getAttribute('data-tag') || '').toLowerCase().trim();
        if (selectedTags.has(tag)) {
          selectedTags.delete(tag);
          btn.classList.remove('active');
        } else {
          selectedTags.add(tag);
          btn.classList.add('active');
        }

        if (selectedTags.size === 0) {
          if (allBtn) allBtn.classList.add('active');
        } else {
          if (allBtn) allBtn.classList.remove('active');
        }

        filterItems();
      });
    });
  });
</script>
