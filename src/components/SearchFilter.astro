---
interface Props {
  placeholder?: string;
  targetSelector?: string;
  tags?: string[];
}

const {
  placeholder = 'grep -i "query" items...',
  targetSelector = '.curated-link-card',
  tags = [],
} = Astro.props;
---

<section class="grep-filter-container" data-target={targetSelector}>
  <input
    type="search"
    class="grep-input-field"
    placeholder={placeholder}
    aria-label="Filter links"
  />

  {tags.length > 0 && (
    <div class="quick-tags-row">
      <span class="quick-tags-label">TAGS:</span>
      <button type="button" class="quick-tag-btn active" data-tag="all">[ALL]</button>
      {tags.map((t) => (
        <button type="button" class="quick-tag-btn" data-tag={t}>
          [{t}]
        </button>
      ))}
    </div>
  )}
</section>

<style>
  .grep-filter-container {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 10px 14px;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .grep-input-field {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 6px 10px;
    outline: none;
  }

  .grep-input-field:focus {
    border-color: var(--primary);
  }

  .quick-tags-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
  }

  .quick-tags-label {
    font-weight: bold;
    color: var(--text-muted);
    font-size: 11px;
    margin-right: 4px;
  }

  .quick-tag-btn {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 1px 6px;
    cursor: pointer;
  }

  .quick-tag-btn:hover {
    border-color: var(--text);
  }

  .quick-tag-btn.active {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
    font-weight: bold;
  }
</style>

<script is:inline>
  // Live grep filter
  const container = document.querySelector('.grep-filter-container');
  if (container) {
    const targetSelector = container.getAttribute('data-target') || '.curated-link-card';
    const input = container.querySelector('.grep-input-field');
    const tagButtons = container.querySelectorAll('.quick-tag-btn');
    let activeTag = 'all';

    function filterItems() {
      const query = input ? input.value.toLowerCase().trim() : '';
      const items = document.querySelectorAll(targetSelector);

      items.forEach((item) => {
        const text = item.innerText.toLowerCase();
        const itemTags = (item.getAttribute('data-tags') || '')
          .split(',')
          .map((t) => t.trim().toLowerCase())
          .filter(Boolean);

        const matchesQuery = !query || text.includes(query);
        const matchesTag = activeTag === 'all' || itemTags.includes(activeTag.toLowerCase());

        if (matchesQuery && matchesTag) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    }

    if (input) {
      input.addEventListener('input', filterItems);
    }

    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tagButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeTag = btn.getAttribute('data-tag') || 'all';
        filterItems();
      });
    });
  }
</script>
